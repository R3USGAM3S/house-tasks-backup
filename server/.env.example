# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel the same names are set in Project → Settings → Environment Variables
# (and Turso injects TURSO_DATABASE_URL / TURSO_AUTH_TOKEN via Marketplace).
# On Plesk the same names can be set in the Node.js settings instead.

# Long random secret for login tokens. Create one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Code new residents need to create an account (at least 12 characters)
HOUSE_CODE=

# Password for the admin page (/admin). Leave empty to switch the admin page off.
ADMIN_PASSWORD=

# Public address of the app, shown as a QR code on the admin page. Leave empty at home.
PUBLIC_URL=

# Turso (required on Vercel; also for local runs against the cloud DB)
# Pull with: vercel env pull .env.local
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port. Plesk sets this itself; default is 3001.
# PORT=3001
