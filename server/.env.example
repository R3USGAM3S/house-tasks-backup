# Copy this file to .env and fill in the values. Never commit .env.
# On Plesk the same names can be set in the Node.js settings instead.

# Long random secret for login tokens. Create one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Code new residents need to create an account (at least 12 characters)
HOUSE_CODE=

# Password for the admin page (/admin). Leave empty to switch the admin page off.
ADMIN_PASSWORD=

# Public address of the app, shown as a QR code on the admin page. Leave empty at home.
PUBLIC_URL=

# Port. Plesk sets this itself; default is 3001.
# PORT=3001
